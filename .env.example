# Backend-only secrets. Never commit a real .env.
FREEMODEL_API_KEY=
FREEMODEL_BASE_URL=https://freemodel.in/v1
# Optional per-task model overrides (otherwise chosen from the live FreeModel catalogue)
ANVAYA_MODEL_REASONING=
ANVAYA_MODEL_AGENT=
ANVAYA_MODEL_EXTRACTION=
ANVAYA_MODEL_SUMMARISATION=
ANVAYA_MODEL_REPORT=
ANVAYA_RPM=50
ANVAYA_DATA_DIR=./data
ANVAYA_CORS_ORIGINS=http://localhost:5173
ANVAYA_ALLOW_REGISTRATION=true
